{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "instructions",
    "background",
    "revision",
    "sources",
    "conversation_count",
    "membership_token",
    "historical_copies",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "conversation_count": {
      "type": "integer",
      "minimum": 0
    },
    "membership_token": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "historical_copies": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "snapshot",
          "blob_hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "snapshot": {
            "$ref": "attachment.schema.json"
          },
          "blob_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "usage": {
            "enum": [
              "always",
              "search"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
