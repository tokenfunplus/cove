{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Batch",
  "type": "object",
  "required": ["id", "conversation_id", "client_request_id", "state", "targets", "events_url", "created_at", "updated_at"],
  "properties": {
    "project_context_id": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "project_context": { "$ref": "project-context.schema.json" },
    "web_search": { "$ref": "generation.schema.json#/$defs/webSearchPolicy" },
    "id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "client_request_id": { "type": "string" },
    "user_message_id": { "type": "string" },
    "input_content": { "type": "string" },
    "attachments": { "type": "array", "maxItems": 4, "items": { "$ref": "attachment.schema.json" } },
    "state": { "enum": ["pending", "streaming", "completed", "completed_with_errors", "stopped", "failed"] },
    "events_url": { "type": "string" },
    "selected_generation_id": { "type": "string" },
    "selected_answer": {
      "type": "object",
      "required": ["generation_id", "assistant_message_id", "provider_name", "model_id"],
      "properties": {
        "generation_id": { "type": "string" },
        "assistant_message_id": { "type": "string" },
        "provider_name": { "type": "string" },
        "model_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "context_skipped": { "type": "boolean" },
    "context_frozen": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "provider_id", "model_id", "position", "generation"],
        "properties": {
          "id": { "type": "string" },
          "provider_id": { "type": "string" },
          "model_id": { "type": "string" },
          "position": { "type": "integer", "minimum": 0 },
          "generation": {
            "type": "object",
            "required": ["id", "state", "snapshot", "configuration_snapshot", "verification"],
            "properties": {
              "web_search": { "$ref": "generation.schema.json#/$defs/webSearchInfo" },
              "metrics": { "$ref": "generation.schema.json#/$defs/generationMetrics" },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" },
              "id": { "type": "string" },
              "state": { "enum": ["pending", "verifying_environment", "streaming", "verifying_response", "completed", "stopped", "failed"] },
              "snapshot": { "$ref": "generation.schema.json#/$defs/providerSnapshot" },
              "configuration_snapshot": { "$ref": "generation.schema.json#/$defs/generationConfigurationSnapshot" },
              "verification": { "$ref": "generation.schema.json#/$defs/generationVerification" },
              "assistant_message_id": { "type": "string" },
              "error_code": { "type": "string" },
              "error_message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
