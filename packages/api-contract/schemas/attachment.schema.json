{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attachment Snapshot",
  "type": "object",
  "required": [
    "id",
    "name",
    "media_type",
    "size",
    "characters",
    "extraction_version",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "media_type": {
      "enum": [
        "text/plain",
        "application/pdf"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "characters": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "extraction_version": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[LP][1-9][0-9]*$"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
