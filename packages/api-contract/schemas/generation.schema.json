{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation",
  "type": "object",
  "$defs": {
    "webSearchPolicy": {
      "type": "object",
      "required": [
        "provider",
        "max_searches",
        "max_pages",
        "max_rounds",
        "max_results",
        "timeout_seconds",
        "depth"
      ],
      "properties": {
        "provider": {
          "enum": [
            "tavily",
            "linkup",
            "exa"
          ]
        },
        "depth": {
          "enum": [
            "standard",
            "deep"
          ]
        },
        "max_searches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 180
        },
        "include_domains": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "exclude_domains": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "webSearchInfo": {
      "type": "object",
      "required": [
        "provider",
        "searches",
        "pages",
        "steps",
        "sources"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "searches": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status",
              "started_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "started_at": {
                "type": "string"
              },
              "finished_at": {
                "type": "string"
              },
              "cached": {
                "type": "boolean"
              },
              "usage": {}
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "attachment.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "generationMetrics": {
      "type": "object",
      "required": [
        "source",
        "duration_ms"
      ],
      "properties": {
        "source": {
          "enum": [
            "service",
            "browser"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "time_to_first_token_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "output_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "additionalProperties": false
    },
    "providerSnapshot": {
      "type": "object",
      "required": [
        "provider_id",
        "provider_name",
        "model_id",
        "runtime_location",
        "destination",
        "transport_security",
        "privacy_notice"
      ],
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "nearai",
            "openai_compatible",
            "local"
          ]
        },
        "local_model": {
          "type": "object",
          "required": [
            "revision",
            "sha256",
            "runtime_version"
          ],
          "properties": {
            "revision": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runtime_version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "provider_name": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "runtime_location": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "transport_security": {
          "enum": [
            "tls",
            "plaintext",
            "unknown"
          ]
        },
        "privacy_notice": {
          "type": "string"
        },
        "privacy_mode": {
          "enum": [
            "private_tee",
            "incognito",
            "chutes"
          ]
        }
      },
      "additionalProperties": false
    },
    "generationConfigurationSnapshot": {
      "type": "object",
      "required": [
        "system_prompt",
        "temperature",
        "top_p",
        "max_tokens"
      ],
      "properties": {
        "web_search": {
          "$ref": "#/$defs/webSearchPolicy"
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 32768
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "generationVerification": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified_model",
            "verified_gateway",
            "failed",
            "unsupported"
          ]
        },
        "completion_id": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature_kind": {
          "enum": [
            "provider_tee",
            "gateway"
          ]
        },
        "signing_address": {
          "type": "string"
        },
        "signing_algorithm": {
          "type": "string"
        },
        "signed_message": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "signature_digest": {
          "type": "string"
        },
        "evidence_summary": {
          "type": "string"
        },
        "failure_code": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "model",
                "gateway"
              ]
            },
            "signer_address": {
              "type": "string"
            },
            "signing_algorithm": {
              "type": "string"
            },
            "tcb_status": {
              "type": "string"
            },
            "advisory_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gpu_evidence": {
              "enum": [
                "not_provided",
                "verified"
              ]
            },
            "tls_binding": {
              "enum": [
                "none",
                "attested"
              ]
            },
            "deployment": {
              "type": "object",
              "properties": {
                "app_compose": {
                  "type": "string"
                },
                "os_image_hash": {
                  "type": "string"
                },
                "compose_hash": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "raw": {
              "type": "object",
              "additionalProperties": true
            },
            "model": {
              "$ref": "#/$defs/generationVerification/properties/evidence"
            },
            "gateway": {
              "$ref": "#/$defs/generationVerification/properties/evidence"
            }
          },
          "additionalProperties": false
        },
        "lanes": {
          "type": "object",
          "required": [
            "gateway",
            "response"
          ],
          "properties": {
            "gateway": {
              "enum": [
                "pending",
                "verified",
                "failed"
              ]
            },
            "model": {
              "enum": [
                "pending",
                "verified",
                "failed"
              ]
            },
            "response": {
              "enum": [
                "pending",
                "verified",
                "failed"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "conversation_id",
    "client_request_id",
    "state",
    "snapshot",
    "configuration_snapshot",
    "verification",
    "events_url",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "web_search": {
      "$ref": "#/$defs/webSearchInfo"
    },
    "metrics": {
      "$ref": "#/$defs/generationMetrics"
    },
    "id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "client_request_id": {
      "type": "string"
    },
    "user_message_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "verifying_environment",
        "streaming",
        "verifying_response",
        "completed",
        "stopped",
        "failed"
      ]
    },
    "snapshot": {
      "$ref": "#/$defs/providerSnapshot"
    },
    "configuration_snapshot": {
      "$ref": "#/$defs/generationConfigurationSnapshot"
    },
    "verification": {
      "$ref": "#/$defs/generationVerification"
    },
    "assistant_message_id": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "events_url": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "local_only": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
