[
  {
    "id": "access",
    "text": "\u65b0\u540c\u4e8b\u52a0\u5165\u9879\u76ee\u540e\uff0c\u5148\u7531\u8d1f\u8d23\u4eba\u786e\u8ba4\u6240\u9700\u6743\u9650\uff0c\u518d\u5411\u7ba1\u7406\u5458\u63d0\u4ea4\u8d26\u53f7\u7533\u8bf7\u3002\u7ba1\u7406\u5458\u521b\u5efa\u8d26\u53f7\u5e76\u5f00\u542f\u53cc\u91cd\u9a8c\u8bc1\uff0c\u5458\u5de5\u9996\u6b21\u767b\u5f55\u540e\u5e94\u66f4\u6362\u4e34\u65f6\u53e3\u4ee4\u3002\u79bb\u5f00\u9879\u76ee\u65f6\u5e94\u53ca\u65f6\u64a4\u9500\u8d26\u53f7\u8bbf\u95ee\u6743\u9650\u3002",
    "query": "\u521a\u52a0\u5165\u56e2\u961f\u7684\u4eba\u600e\u6837\u62ff\u5230\u7cfb\u7edf\u8bbf\u95ee\u8d44\u683c\uff1f"
  },
  {
    "id": "backup",
    "text": "\u9879\u76ee\u6587\u4ef6\u6bcf\u5929\u591c\u95f4\u8fdb\u884c\u589e\u91cf\u5907\u4efd\uff0c\u6bcf\u5468\u65e5\u751f\u6210\u5b8c\u6574\u5907\u4efd\u3002\u5907\u4efd\u526f\u672c\u4fdd\u7559\u4e09\u5341\u5929\uff0c\u6bcf\u4e2a\u6708\u7531\u7ba1\u7406\u5458\u62bd\u53d6\u4e00\u4e2a\u526f\u672c\u8fdb\u884c\u6062\u590d\u6f14\u7ec3\uff0c\u786e\u8ba4\u6570\u636e\u53ef\u4ee5\u8bfb\u53d6\u3002",
    "query": "\u8bef\u5220\u6587\u4ef6\u540e\u8981\u4ece\u54ea\u91cc\u627e\u56de\u6570\u636e\uff0c\u526f\u672c\u4fdd\u5b58\u591a\u4e45\uff1f"
  },
  {
    "id": "release",
    "text": "\u4ea7\u54c1\u53d1\u5e03\u524d\u5148\u5b8c\u6210\u81ea\u52a8\u68c0\u67e5\uff0c\u518d\u90e8\u7f72\u5230\u6d4b\u8bd5\u73af\u5883\u3002\u8d1f\u8d23\u4eba\u786e\u8ba4\u9a8c\u6536\u7ed3\u679c\u540e\uff0c\u624d\u53ef\u5c06\u7248\u672c\u53d1\u5e03\u5230\u6b63\u5f0f\u73af\u5883\u3002\u82e5\u51fa\u73b0\u6545\u969c\uff0c\u4f7f\u7528\u4e0a\u4e00\u4e2a\u7a33\u5b9a\u7248\u672c\u56de\u6eda\u3002",
    "query": "\u600e\u6837\u628a\u65b0\u7248\u672c\u5b89\u5168\u5730\u4ea4\u4ed8\u5230\u7ebf\u4e0a\uff0c\u51fa\u95ee\u9898\u600e\u4e48\u529e\uff1f"
  },
  {
    "id": "garden",
    "text": "\u9633\u53f0\u756a\u8304\u6bcf\u5929\u9700\u8981\u5145\u8db3\u65e5\u7167\uff0c\u6d47\u6c34\u524d\u5148\u89c2\u5bdf\u571f\u58e4\u662f\u5426\u53d8\u5e72\u3002\u5929\u6c14\u708e\u70ed\u65f6\u53ef\u5728\u6e05\u6668\u8865\u6c34\uff0c\u907f\u514d\u6839\u90e8\u957f\u671f\u79ef\u6c34\u3002\u690d\u682a\u957f\u9ad8\u540e\u8981\u642d\u5efa\u652f\u67b6\uff0c\u9632\u6b62\u679d\u6761\u6298\u65ad\u3002",
    "query": "\u76c6\u683d\u756a\u8304\u4ec0\u4e48\u65f6\u5019\u8865\u6c34\u6bd4\u8f83\u5408\u9002\uff1f"
  },
  {
    "id": "bicycle",
    "text": "\u9a91\u884c\u524d\u68c0\u67e5\u8f6e\u80ce\u6c14\u538b\u548c\u5239\u8f66\u662f\u5426\u6b63\u5e38\u3002\u94fe\u6761\u5e94\u5b9a\u671f\u6e05\u6d01\u5e76\u5c11\u91cf\u6da6\u6ed1\uff0c\u53d1\u73b0\u677e\u52a8\u6216\u5f02\u54cd\u65f6\u6682\u505c\u4f7f\u7528\u3002\u591c\u95f4\u51fa\u884c\u8981\u6253\u5f00\u8f66\u706f\uff0c\u5e76\u4f69\u6234\u5408\u9002\u7684\u5934\u76d4\u3002",
    "query": "\u81ea\u884c\u8f66\u51fa\u95e8\u4e4b\u524d\u6709\u54ea\u4e9b\u90e8\u4ef6\u9700\u8981\u67e5\u770b\uff1f"
  },
  {
    "id": "bread",
    "text": "\u5236\u4f5c\u9762\u5305\u65f6\u5148\u5c06\u9762\u7c89\u4e0e\u6c34\u6df7\u5408\uff0c\u518d\u52a0\u5165\u9175\u6bcd\u5e76\u63c9\u6210\u9762\u56e2\u3002\u7b2c\u4e00\u6b21\u53d1\u9175\u81f3\u4f53\u79ef\u660e\u663e\u589e\u52a0\u540e\u6574\u5f62\uff0c\u7ecf\u8fc7\u7b2c\u4e8c\u6b21\u53d1\u9175\u518d\u9001\u5165\u9884\u70ed\u7684\u70e4\u7bb1\u3002\u51fa\u7089\u540e\u653e\u5728\u7f51\u67b6\u4e0a\u51b7\u5374\u3002",
    "query": "\u70e4\u9762\u5305\u524d\u4e3a\u4ec0\u4e48\u9700\u8981\u8ba9\u9762\u56e2\u53d1\u9175\u4e24\u6b21\uff1f"
  },
  {
    "id": "library",
    "text": "\u56fe\u4e66\u9986\u501f\u9605\u7684\u666e\u901a\u56fe\u4e66\u53ef\u4fdd\u7559\u4e8c\u5341\u4e00\u5929\uff0c\u5c1a\u672a\u88ab\u9884\u7ea6\u7684\u56fe\u4e66\u53ef\u5728\u7ebf\u7eed\u501f\u4e00\u6b21\u3002\u73cd\u8d35\u8d44\u6599\u53ea\u80fd\u5728\u9605\u89c8\u5ba4\u4f7f\u7528\uff0c\u4e0d\u5f97\u5e26\u79bb\u9986\u5185\u3002\u9057\u5931\u56fe\u4e66\u9700\u8981\u8054\u7cfb\u670d\u52a1\u53f0\u529e\u7406\u767b\u8bb0\u3002",
    "query": "\u501f\u6765\u7684\u4e66\u8fd8\u6ca1\u8bfb\u5b8c\uff0c\u53ef\u4ee5\u5ef6\u957f\u5f52\u8fd8\u65f6\u95f4\u5417\uff1f"
  },
  {
    "id": "meeting",
    "text": "\u4f8b\u4f1a\u5b89\u6392\u5728\u6bcf\u5468\u4e09\u4e0a\u5348\uff0c\u53c2\u4e0e\u8005\u5e94\u63d0\u524d\u4e00\u5929\u63d0\u4ea4\u8bae\u9898\u3002\u4e3b\u6301\u4eba\u6309\u8bae\u9898\u9010\u9879\u8bb0\u5f55\u51b3\u5b9a\u548c\u8d1f\u8d23\u4eba\uff0c\u4f1a\u540e\u5c06\u5f85\u529e\u4e8b\u9879\u53d1\u7ed9\u53c2\u4e0e\u8005\uff0c\u4e0b\u6b21\u4f1a\u8bae\u68c0\u67e5\u6267\u884c\u8fdb\u5ea6\u3002",
    "query": "\u56e2\u961f\u6bcf\u5468\u7684\u8ba8\u8bba\u5982\u4f55\u51c6\u5907\u8bae\u7a0b\u5e76\u8ddf\u8fdb\u51b3\u5b9a\uff1f"
  },
  {
    "id": "battery",
    "text": "\u7b14\u8bb0\u672c\u957f\u671f\u95f2\u7f6e\u65f6\uff0c\u5e94\u4fdd\u6301\u9002\u5f53\u7535\u91cf\u5e76\u5b58\u653e\u5728\u5e72\u71e5\u9634\u51c9\u5904\u3002\u4e0d\u8981\u628a\u8bbe\u5907\u653e\u5728\u9ad8\u6e29\u8f66\u5185\u3002\u82e5\u53d1\u73b0\u7535\u6c60\u9f13\u5305\uff0c\u5e94\u505c\u6b62\u4f7f\u7528\u8bbe\u5907\u5e76\u8054\u7cfb\u4e13\u4e1a\u7ef4\u4fee\u4eba\u5458\u3002",
    "query": "\u7535\u8111\u5f88\u4e45\u4e0d\u7528\u65f6\u600e\u6837\u4fdd\u5b58\uff0c\u907f\u514d\u7535\u6c60\u53d7\u635f\uff1f"
  },
  {
    "id": "travel",
    "text": "\u77ed\u9014\u5f92\u6b65\u524d\u5e94\u68c0\u67e5\u5929\u6c14\u9884\u62a5\uff0c\u9009\u62e9\u9002\u5408\u81ea\u8eab\u80fd\u529b\u7684\u8def\u7ebf\u3002\u968f\u8eab\u643a\u5e26\u996e\u7528\u6c34\u3001\u98df\u7269\u548c\u79bb\u7ebf\u5730\u56fe\uff0c\u5c06\u9884\u8ba1\u8fd4\u56de\u65f6\u95f4\u544a\u77e5\u540c\u884c\u8005\u3002\u9047\u5230\u6076\u52a3\u5929\u6c14\u5e94\u53ca\u65f6\u8fd4\u56de\u3002",
    "query": "\u53bb\u5c71\u91cc\u8d70\u4e00\u5929\u9700\u8981\u63d0\u524d\u51c6\u5907\u54ea\u4e9b\u7269\u54c1\uff1f"
  },
  {
    "id": "plant",
    "text": "\u7ed9\u5ba4\u5185\u7eff\u690d\u6362\u76c6\u65f6\uff0c\u9009\u62e9\u7a0d\u5927\u7684\u82b1\u76c6\u5e76\u786e\u4fdd\u5e95\u90e8\u6709\u6392\u6c34\u5b54\u3002\u8f7b\u8f7b\u677e\u5f00\u7f20\u7ed5\u7684\u6839\u7cfb\uff0c\u52a0\u5165\u758f\u677e\u571f\u58e4\u540e\u6d47\u4e00\u6b21\u900f\u6c34\u3002\u6362\u76c6\u540e\u7684\u51e0\u5929\u907f\u514d\u5f3a\u70c8\u76f4\u5c04\u9633\u5149\u3002",
    "query": "\u5bb6\u91cc\u7684\u690d\u7269\u957f\u5927\u4ee5\u540e\u8be5\u5982\u4f55\u66f4\u6362\u5bb9\u5668\uff1f"
  },
  {
    "id": "photos",
    "text": "\u6574\u7406\u7167\u7247\u65f6\uff0c\u5148\u6309\u62cd\u6444\u5e74\u4efd\u5efa\u7acb\u6587\u4ef6\u5939\uff0c\u518d\u5c06\u91cd\u8981\u6d3b\u52a8\u5355\u72ec\u5f52\u7c7b\u3002\u539f\u59cb\u7167\u7247\u5e94\u4fdd\u7559\u4e00\u4efd\u5907\u4efd\uff0c\u5206\u4eab\u4e4b\u524d\u68c0\u67e5\u662f\u5426\u5305\u542b\u4e0d\u9002\u5408\u516c\u5f00\u7684\u4e2a\u4eba\u4fe1\u606f\u3002",
    "query": "\u600e\u4e48\u628a\u591a\u5e74\u62cd\u7684\u56fe\u7247\u5f52\u6863\uff0c\u65b9\u4fbf\u4ee5\u540e\u5bfb\u627e\uff1f"
  }
]
